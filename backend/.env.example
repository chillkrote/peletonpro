# Kommagetrennte Liste erlaubter Frontend-Origins (CORS)
CORS_ORIGINS=http://localhost:8000,https://chillkrote.github.io

# User-Agent für alle Scraping-Requests (Kontakt/Repo, damit Betreiber der
# Zielseite den Bot einordnen können)
SCRAPER_USER_AGENT=PelotonProBot/1.0 (+https://github.com/chillkrote/peletonpro)

# Mindestabstand zwischen Requests an dieselbe Quelle (Sekunden)
SCRAPER_REQUEST_DELAY_SECONDS=2.0
SCRAPER_TIMEOUT_SECONDS=15.0

# Saison-Jahr für Teams/Kalender
RACE_SEASON_YEAR=2026

# Aktualisierungsintervalle in Sekunden
REFRESH_INTERVAL_TEAMS=86400
REFRESH_INTERVAL_CALENDAR=86400
REFRESH_INTERVAL_RESULTS=3600
REFRESH_INTERVAL_NEWS=900

# Kader aller WorldTeams (ein Wikipedia-Abruf pro Team). Kader ändern sich ein
# paar Mal im Jahr - ein Tagestakt reicht. Vorher steckte das im selben Job wie
# der Rückstands-Abbau und lief alle drei Minuten.
REFRESH_INTERVAL_ROSTERS=86400

# Rückstand abbauen: Team-Historie und Strava-Abgleich für Fahrer, die noch
# keine haben. Kurzer Takt, weil der Job batchweise arbeitet; ist der Rückstand
# leer, kostet ein Lauf zwei billige Abfragen.
REFRESH_INTERVAL_RIDER_DETAILS=900
# Zeitbudget pro Lauf - der Job arbeitet, solange Budget übrig ist, statt eine
# feste Zahl Einträge zu holen. Muss deutlich unter dem Intervall liegen.
RIDER_DETAILS_RUN_SECONDS=120

# Renn-Historie: Seeding und Detail-Backfill. Budget deckt beide Phasen ab.
# Beide Rückstands-Jobs teilen sich einen Executor mit einem Worker, ihre
# Budgets zusammen müssen also unter das Intervall passen (600 + 120 < 900).
REFRESH_INTERVAL_RACE_HISTORY=900
RACE_HISTORY_RUN_SECONDS=600

# Abfrage-Fenster der Rückstands-Jobs: wie viele Einträge pro Runde aus der
# Datenbank geholt werden. Die Laufzeit bestimmt inzwischen das Budget oben,
# nicht diese Zahl - sie steuert nur, wie oft nachgefragt wird.
RIDER_HISTORY_BATCH_SIZE=30
RACE_HISTORY_DETAIL_BATCH_SIZE=15

# Wikidata-Strava-Abgleich: bis zu 50 Titel pro Request, daher größere Batches
# als bei der Historie (dort ein Abruf pro Fahrer).
STRAVA_BATCH_SIZE=50

# Ab welchem Jahr die Renn-Historie geseedet wird. Absenken holt weitere Jahre
# nach, ohne vorhandene Daten anzurühren (das Seeding ist idempotent).
RACE_HISTORY_START_YEAR=2020

# Startversatz zwischen den Jobs beim Hochfahren, damit sie sich nicht alle
# gleichzeitig vor dem einen scrape-Worker stauen.
JOB_START_STAGGER_SECONDS=5

# Verzeichnis für den persistenten JSON-Cache
CACHE_DIR=./data

# --- Postgres-Verbindungs-Pool (siehe app/db.py) ---
# Bewusst klein: ein Web-Prozess plus ein Scheduler mit wenigen Threads
# braucht nicht mehr, und Renders kostenloser Plan hat ein knappes
# Verbindungskontingent.
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
# Wie lange ein Aufrufer auf eine freie Verbindung wartet (Sekunden)
DB_POOL_TIMEOUT_SECONDS=30

# --- Backup (siehe README, Abschnitt "Backup", und app/backup.py) ---
# Verbindung zur Postgres-Datenbank. Ohne diese Variable bleiben Fahrer- und
# Renn-Historie-Endpunkte leer, die App läuft aber weiter (siehe app/db.py).
# Auf Render: "Internal Database URL" der Postgres-Instanz.
DATABASE_URL=postgresql://benutzer:passwort@host:5432/datenbank

# Zielverzeichnis für Dumps (Default: backend/backups)
BACKUP_DIR=./backups

# Nur die letzten N Dump-Läufe behalten (0 oder weggelassen = alle behalten).
# Wirkt nur, wenn dump ohne explizites --keep aufgerufen wird.
BACKUP_KEEP=7
