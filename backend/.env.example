# Kommagetrennte Liste erlaubter Frontend-Origins (CORS)
CORS_ORIGINS=http://localhost:8000,https://chillkrote.github.io

# User-Agent für alle Scraping-Requests (Kontakt/Repo, damit Betreiber der
# Zielseite den Bot einordnen können)
SCRAPER_USER_AGENT=PelotonProBot/1.0 (+https://github.com/chillkrote/peletonpro)

# Mindestabstand zwischen Requests an dieselbe Quelle (Sekunden)
SCRAPER_REQUEST_DELAY_SECONDS=2.0
SCRAPER_TIMEOUT_SECONDS=15.0

# Saison-Jahr für Teams/Kalender
RACE_SEASON_YEAR=2026

# Aktualisierungsintervalle in Sekunden
REFRESH_INTERVAL_TEAMS=86400
REFRESH_INTERVAL_CALENDAR=86400
REFRESH_INTERVAL_RESULTS=300
REFRESH_INTERVAL_NEWS=900

# Verzeichnis für den persistenten JSON-Cache
CACHE_DIR=./data

# --- Backup (siehe README, Abschnitt "Backup", und app/backup.py) ---
# Verbindung zur Postgres-Datenbank. Ohne diese Variable bleiben Fahrer- und
# Renn-Historie-Endpunkte leer, die App läuft aber weiter (siehe app/db.py).
# Auf Render: "Internal Database URL" der Postgres-Instanz.
DATABASE_URL=postgresql://benutzer:passwort@host:5432/datenbank

# Zielverzeichnis für Dumps (Default: backend/backups)
BACKUP_DIR=./backups

# Nur die letzten N Dump-Läufe behalten (0 oder weggelassen = alle behalten).
# Wirkt nur, wenn dump ohne explizites --keep aufgerufen wird.
BACKUP_KEEP=7
